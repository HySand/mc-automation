# Enable sites explicitly. Keep credentials in GitHub Actions Secrets.
KLPBBS_ENABLED=false
KLPBBS_USERNAME=
KLPBBS_PASSWORD=
KLPBBS_THREAD_ID=
KLPBBS_BASE_URL=https://klpbbs.com
KLPBBS_PROMOTION_ENABLED=false
KLPBBS_PROMOTION_MAX_VISITS=10
KLPBBS_PROMOTION_VISIT_DELAY_SECONDS=2

MINEBBS_ENABLED=false
MINEBBS_USERNAME=
MINEBBS_PASSWORD=
# Accepts a numeric ID, a XenForo slug.ID segment, or a full MineBBS thread URL.
MINEBBS_THREAD_ID=
MINEBBS_BASE_URL=https://www.minebbs.com
MINEBBS_BUMP_INTERVAL_HOURS=16
# Optional non-AI nodriver handling for the Alibaba ESA slide-to-end challenge.
MINEBBS_ESA_SLIDER_ENABLED=false
# Optional explicit Chromium-family browser executable. Leave empty for nodriver auto-discovery;
# Windows also falls back to an installed Microsoft Edge.
MINEBBS_BROWSER_EXECUTABLE_PATH=

# Optional OpenAI-compatible vision solver for the WDSJFWQ image captcha only.
# Keep endpoint and API key in GitHub Actions Secrets.
AI_SOLVER_ENABLED=false
AI_SOLVER_ENDPOINT=
AI_SOLVER_API_KEY=
AI_SOLVER_MODEL=
AI_SOLVER_TIMEOUT_SECONDS=60
AI_SOLVER_MAX_ATTEMPTS=1
# Empty means inherit AI_SOLVER_ENABLED.
AI_SOLVER_WDSJFWQ_CAPTCHA_ENABLED=

WDSJFWQ_ENABLED=false
WDSJFWQ_LIKE_URL=https://www.wdsjfwq.com/server-1991/vote.html
MCLISTS_ENABLED=false
MCLISTS_LIKE_URL=https://www.mclists.cn/server/9969.html

STATE_PATH=.state/state.json
RANK_THRESHOLD=8
PAID_BUMP_COOLDOWN_SECONDS=3600
